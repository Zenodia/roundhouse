{
  "$comment": [
    "docker-privesc catalog. Same frontier leg as sandbox-breach (azure/anthropic/claude-opus-5",
    "via inference-api.nvidia.com, anthropic_messages wire) plus a local Dynamo-served Qwen leg",
    "discovered at runtime via ROUNDHOUSE_LOCAL_* env vars. The A/B comparison shows the exploit",
    "is architectural — model-independent. Auth env is INFERENCE_API_KEY."
  ],

  "providers": {
    "nvidia-inference-api": {
      "base_url": "https://inference-api.nvidia.com/v1",
      "routes": { "messages": "/messages" },
      "auth": { "env": "INFERENCE_API_KEY", "style": "bearer" }
    }
  },

  "models": [
    {
      "provider": "nvidia-inference-api",
      "model": "azure/anthropic/claude-opus-5",
      "wire_protocol": "anthropic_messages",
      "cache_model": {
        "kind": "deterministic",
        "ttl_ms": 300000
      },
      "pricing": {
        "input_per_mtok_usd": 15.0,
        "cached_input_per_mtok_usd": 1.5,
        "cache_write_per_mtok_usd": 0.0,
        "output_per_mtok_usd": 75.0
      },
      "quality_prior": 0.95,
      "base_ttft_ms": 350.0,
      "ttft_ms_per_uncached_token": 0.0015
    }
  ],

  "local_quality": { "Qwen/Qwen2.5-7B-Instruct": 0.72 },

  "correlaries": [],

  "default_local_quality": 0.5,
  "capability_band": 0.10
}
